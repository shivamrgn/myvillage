# =============================================================================
# Gram Samadhan — Environment Configuration Reference
# =============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these variables in Project Settings.
# =============================================================================

# ── Frontend Client Environment Variables (Exposed to Browser via Vite) ─────
# IMPORTANT: ONLY variables prefixed with VITE_ are included in the frontend bundle.
# NEVER put private API keys or service role secrets here!

# 1. Supabase Public Connection
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Panchayat Identity & Localization
VITE_APP_PANCHAYAT_NAME=ग्राम पंचायत सुंदरपुर (Sundarpur)
VITE_APP_HELPLINE=1800-180-1555
VITE_DEFAULT_LANGUAGE=hi

# 3. Notification Service Configuration
# Options: 'mock' (default console simulation) | 'webhook' | 'fast2sms'
VITE_SMS_PROVIDER=mock
VITE_SMS_WEBHOOK_URL=https://your-automation-webhook.example.com/sms

# 4. Optional Direct Audio STT Endpoint (defaults to Supabase transcribe-audio function)
VITE_STT_API_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/transcribe-audio

# -----------------------------------------------------------------------------
# Backend Supabase Edge Function Secrets (Configured via Supabase CLI / Dashboard)
# -----------------------------------------------------------------------------
# Set these securely in the backend via:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY="..." SMS_PROVIDER="fast2sms"
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (Confidential: Never commit or expose to client)
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_api_key
# OPENAI_API_KEY=sk-proj-your_openai_whisper_key
# GROQ_API_KEY=gsk_your_groq_whisper_key
# GOOGLE_CLOUD_API_KEY=your_google_cloud_speech_key
# ALLOWED_ORIGIN=https://gramsamadhan.yourpanchayat.in


